# Shared .env.example template for all 9 services

# Global common
SECRET_KEY=your_secret_key_here_change_in_production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/bloodchain
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=bloodchain

# Redis (Event Bus & Caching)
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/2
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Blockchain
WEB3_PROVIDER_URI=http://localhost:8545
BLOCKCHAIN_RPC_URL=http://localhost:8545
BLOCKCHAIN_NETWORK_ID=1337
PRIVATE_KEY=your_wallet_private_key_change_in_production
CONTRACT_ADDRESS=0x123...
BLOOD_UNIT_CONTRACT_ADDRESS=0x...
REWARDS_CONTRACT_ADDRESS=0x...

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_change_in_production

# Email Configuration (for notifications service)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-email-password

# Logging
LOG_LEVEL=INFO

# Service Ports
HOSPITAL_SERVICE_PORT=8001
DONOR_SERVICE_PORT=8002
BLOOD_TRACKING_SERVICE_PORT=8003
REWARDS_SERVICE_PORT=8004
NOTIFICATIONS_SERVICE_PORT=8005
USER_MANAGEMENT_SERVICE_PORT=8006
LOCATION_SERVICE_PORT=8007
DATA_WAREHOUSE_PORT=8008
BLOCKCHAIN_GATEWAY_PORT=8009
